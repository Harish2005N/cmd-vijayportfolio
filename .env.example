# Backend API URL for the deployed application
# Used by the frontend to make API requests to your Render backend
# When testing locally, leave blank (same-origin)
# In production (Vercel), the hostname detection will auto-select this URL
#
# For Vercel, set this as an Environment Variable named API_URL:
# https://cmd-vijayportfolio.onrender.com

API_URL=https://cmd-vijayportfolio.onrender.com
